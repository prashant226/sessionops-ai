# --- Integration mode ---
# "mock" runs the whole product against deterministic local fixtures/adapters
# (no external credentials required). "live" switches Calendar / Sheets / OpenAI
# adapters to the real APIs once credentials below are supplied. The scheduling
# engine (hard rules, scoring, fairness) is identical in both modes -- only the
# data source adapters change. See backend/app/services/*_adapter.py.
INTEGRATION_MODE=mock

# --- Database ---
# Mock mode: local SQLite file, schema mirrors the Supabase/Postgres tables
# described in the product spec so switching is a one-line change later.
DATABASE_URL=sqlite:///./sessionops.db
# Live mode example: postgresql+psycopg2://user:pass@host:5432/postgres

# --- Google OAuth / Calendar / Sheets (live mode only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- OpenAI (live mode only) ---
OPENAI_API_KEY=

# Testing aid (live mode only, optional): redirects every real Calendar
# invite's attendee to this address instead of the SME's own (synthetic,
# non-real) email, so you can actually receive and respond to invites.
GOOGLE_TEST_ATTENDEE_EMAIL=

# --- Auth (demo, fixed credentials per spec) ---
DEMO_OPS_ID=ops
DEMO_OPS_PASSWORD=sessionops
